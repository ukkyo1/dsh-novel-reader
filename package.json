{
  "name": "dsh-novel-reader",
  "version": "0.6.0",
  "description": "Read local txt novels through the chat dialog: pick a novel beside the model selector, one message reads one chapter, and progress is remembered.",
  "license": "MIT",
  "author": "dsh-novel-reader contributors",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "novel",
    "reader",
    "txt",
    "chapter"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "samples/*.txt",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/host-harness.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
